{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=users.db"
  },
  "Jwt": {
    "Issuer": "RealEstateApi",
    "Audience": "RealEstateApiClients",
    "Key": "change-this-training-secret-key-at-least-32-chars-long",
    "ExpiresMinutes": 60
  },
  "AdminSeed": {
    "Email": "admin@realestate.local",
    "Password": "Admin12345"
  },
  "AllowedHosts": "*",
  "Caching": {
    "Enabled": true,
    "SizeLimit": 1000,
    "EntityAbsoluteExpirationMinutes": 10,
    "EntitySlidingExpirationMinutes": 3,
    "CurrencyRatesExpirationMinutes": 60
  }
}